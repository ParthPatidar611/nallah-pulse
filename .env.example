# NallahPulse Environment Variables (Example Template)
# Copy this file to .env.local for local development.

# Optional: Google Gemini API Key for coordinate-analysis narrative explanations
# Note: Core NallahPulse risk calculations and priority triage work 100% offline without this key.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Base URL if running an external API server (Leave blank to use Next.js built-in App Router API)
NEXT_PUBLIC_API_BASE_URL=
